{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/apply-pets-proxy.mjs && node scripts/set-site-url.mjs && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/blog/senior-dog-bpc-157-tb-500-story", "destination": "/blog/bpc-157-dog-recovery-videos-south-africa", "permanent": true },
    { "source": "/waitlist", "destination": "/product/mobility-collagen", "permanent": true },
    { "source": "/pets", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/queue", "destination": "/" },
    { "source": "/checkout", "destination": "/" },
    { "source": "/checkout/:path*", "destination": "/" },
    { "source": "/account", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" }
  ],
  "headers": [
    { "source": "/queue", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/checkout/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/account", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/feed.xml", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ],
  "installCommand": "(corepack enable && corepack prepare pnpm@10.12.1 --activate && pnpm install --ignore-scripts --no-frozen-lockfile) || (npx --yes pnpm@10.12.1 install --ignore-scripts --no-frozen-lockfile)"
}
